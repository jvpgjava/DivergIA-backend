# Copie para .env (que NÃO vai para o git) e preencha:
#   cp .env.example .env
# O Spring lê este arquivo sozinho ao subir (spring.config.import em application.yml).
# Formato: CHAVE=valor, sem aspas e sem espaços em volta do "=".

# --- Modelo de linguagem (obrigatório para análise e reescrita) ---------------
# Chave da Abacus.AI (RouteLLM): https://abacus.ai → API Keys
ABACUS_API_KEY=
ABACUS_BASE_URL=https://routellm.abacus.ai/v1
ABACUS_MODEL_NAME=claude-sonnet-5

# --- Embeddings do RAG (opcional: sem a chave, a análise funciona sem exemplos) ---
# Chave do Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Login com Google (opcional) ---------------------------------------------
# Client ID do tipo "Aplicativo da Web" criado no Google Cloud Console.
# O mesmo valor vai no app como --dart-define=GOOGLE_SERVER_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_IDS=

# --- Banco de dados ------------------------------------------------------------
# A URL padrão é jdbc:postgresql://localhost:5432/divergia. NÃO defina DB_URL aqui
# para desenvolvimento: os testes usam o banco divergia_test por padrão, e um DB_URL
# no .env faria os testes rodarem (e apagarem dados) no banco de desenvolvimento.
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Ajustes finos da IA (opcionais; os valores abaixo são os padrões) ----------
# LLM_TIMEOUT_SEGUNDOS=90
# LLM_MAX_TENTATIVAS=2
# LLM_TEMPERATURA_ANALISE=0.0
# LLM_TEMPERATURA_REESCRITA=0.5
# LLM_ENVIAR_TEMPERATURA=true
# ANALISE_MAXIMO_CARACTERES=10000
# IA_TRIAGEM_CONFIANCA_MINIMA=0.7
# IA_JUIZ_FIDELIDADE_HABILITADO=true

# --- E-mail (opcional: recuperação de senha) -----------------------------------
# GMAIL_USERNAME=
# GMAIL_APP_PASSWORD=

# --- JWT (em produção, gere com: openssl rand -base64 48) ----------------------
# JWT_SECRET=
